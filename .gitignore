# PaperFlow root gitignore

# OS files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.Spotlight-V100
.Trashes
VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp
[Dd]esktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.fuse_hidden*

# Editors and IDEs
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.iws
*.iml
*.ipr
out/
.history/
.metadata/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans/
.sts4-cache/
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
*.sublime-project
*.sublime-workspace
*~
*.swp
*.swo

# Logs and temp files
*.log
logs/
tmp/
temp/
.tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
*.env
*.env.*
.gitsecrets
*.pem
*.key
*.pub
*.p12
*.p8
*.jks
*.mobileprovision

# Frontend 
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.eslintcache
frontend/.stylelintcache
frontend/coverage/
frontend/.yarn/
frontend/.pnp.*

# Backend 
backend/target/
backend/build/
backend/out/
backend/bin/
backend/.mvn/wrapper/maven-wrapper.jar
backend/sec/main/resources/application.properties
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/


# Mobile 
mobile/.expo/
mobile/.expo-shared/
mobile/web-build/
mobile/android/
mobile/ios/
mobile/coverage/
mobile/.turbo/
mobile/.cache/

# General build artifacts
dist/
build/
coverage/
*.tsbuildinfo
